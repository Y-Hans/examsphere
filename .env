# =============================================================================
# ExamSphere — Environment Variables
# =============================================================================

# ─── Core ───
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─── Authentication ───
AUTH_SECRET=replace_with_a_secure_string_of_at_least_32_chars
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Database (Oracle) ───
DATABASE_URL=oracle://examsphere:examsphere_pwd@localhost:1521/XEPDB1
ORACLE_SCHEMA=EXAMSPHERE
# For Cloud Autonomous DB, base64 encode the wallet ZIP:
# base64 -w 0 Wallet_DB.zip
ORACLE_WALLET_BASE64=
ORACLE_WALLET_PATH=
ORACLE_WALLET_PASSWORD=

# ─── Storage ───
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# Oracle Object Storage (S3 Compatible)
ORACLE_OBJECT_STORAGE_NAMESPACE=
ORACLE_OBJECT_STORAGE_REGION=us-ashburn-1
ORACLE_OBJECT_STORAGE_BUCKET=examsphere-uploads
ORACLE_OBJECT_STORAGE_ACCESS_KEY=
ORACLE_OBJECT_STORAGE_SECRET_KEY=

# ─── AI Providers ───
AI_PREFERRED_PROVIDER=OPENAI
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=

# ─── Email ───
RESEND_API_KEY=
# SMTP Alternative (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Payments ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# ─── Cron Jobs ───
CRON_SECRET=replace_with_a_random_string

# ─── Observability ───
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=examsphere-api

# ─── Redis (optional, for rate limiting & caching) ───
REDIS_URL=
